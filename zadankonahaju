import turtle
import time
import random

turtle.bgcolor("white")
turtle.title("Wyścig żółwi")

# Meta
meta = turtle.Turtle()
meta.hideturtle()
meta.penup()
meta.goto(300, 200)
meta.pendown()
meta.goto(300, -200)

meta.penup()
meta.goto(240, 220)
meta.write("META", font=("Arial", 15, "bold"))

# Żółwie
kolory = ["red", "blue", "green", "yellow"]

zolwie = []

for i in range(4):
    zolw = turtle.Turtle()
    zolw.shape("turtle")
    zolw.color(kolory[i])
    zolw.pensize(7)
    zolw.penup()
    zolw.goto(-200, 150 - i * 100)
    zolw.pendown()
    zolwie.append(zolw)

# Wybór zwycięzcy
wybor = turtle.textinput(
    "Wyścig żółwi",
    "Wybierz zwycięzcę: red, blue, green lub yellow"
)

while wybor not in kolory:
    wybor = turtle.textinput(
        "Błąd",
        "Wpisz: red, blue, green lub yellow"
    )

# Informacja o typowaniu
info = turtle.Turtle()
info.hideturtle()
info.penup()
info.goto(-280, 220)
info.write("Twój typ: " + wybor, font=("Arial", 12, "bold"))

# Odliczanie
odliczanie = turtle.Turtle()
odliczanie.hideturtle()
odliczanie.penup()
odliczanie.goto(-50, 200)

for x in range(3):
    odliczanie.write(
        3 - x, font=("Arial", 30, "bold")
    )
    time.sleep(1)
    odliczanie.clear()

odliczanie.write("START!", font=("Arial", 25, "bold"))
time.sleep(1)
odliczanie.clear()

# Sprawdzanie zwycięzcy
def sprawdz():
    for i in range(len(zolwie)):
        if zolwie[i].position()[0] >= 300:
            return kolory[i]
    return None

# Wyścig
first = random.randint(0, 3)
zwyciezca = None

while zwyciezca is None:
    for i in range(4):
        nr = (first + i) % 4
        zolwie[nr].forward(random.randint(0, 70))

        zwyciezca = sprawdz()

        if zwyciezca is not None:
            break

    first = (first + 1) % 4
    time.sleep(0.1)

# Wynik typowania
if wybor == zwyciezca:
    trafnosc = "TRAFIONE!"
else:
    trafnosc = "NIETRAFIONE!"

info.goto(-280, 180)
info.write(
    "\nZwycięzca: " + zwyciezca
    + "\n" + trafnosc,
    font=("Arial", 12, "bold")
)

# Suma typowań
poprawne = 0
niepoprawne = 0

if wybor == zwyciezca:
    poprawne += 1
else:
    niepoprawne += 1

info.goto(-280, 100)
info.write(
    "\nPoprawne typowania: " + str(poprawne)
    + "\nNiepoprawne typowania: " + str(niepoprawne),
    font=("Arial", 12, "bold")
)

turtle.mainloop()