import turtle
import random
import time

# Ustawienia okna
screen = turtle.Screen()
screen.title("Wyścig żółwi")
screen.bgcolor("white")

# Linia mety
meta = turtle.Turtle()
meta.hideturtle()
meta.penup()
meta.goto(250, 200)
meta.pendown()
meta.goto(250, -200)

# Informacje o typowaniu
wyniki = turtle.Turtle()
wyniki.hideturtle()
wyniki.penup()
wyniki.goto(-250, 220)

# Kolory i żółwie
kolory = ["red", "blue", "green", "orange"]
zolwie = []

for i in range(len(kolory)):
    zolw = turtle.Turtle()
    zolw.shape("turtle")
    zolw.color(kolory[i])
    zolw.pensize(3)
    zolw.penup()
    zolw.goto(-250, 120 - i * 80)
    zolw.pendown()
    zolwie.append(zolw)

# Statystyki typowania
poprawne = 0
niepoprawne = 0

# Wybór zwycięzcy
wybor = screen.textinput(
    "Typowanie",
    "Wybierz zwycięzcę: red, blue, green lub orange"
)

if wybor is None:
    wybor = ""

wybor = wybor.lower().strip()

while wybor not in kolory:
    wybor = screen.textinput(
        "Błędny wybór",
        "Wpisz: red, blue, green lub orange"
    )
    if wybor is None:
        wybor = ""
    wybor = wybor.lower().strip()

wyniki.write(
    "Twój typ: " + wybor,
    font=("Arial", 14, "bold")
)

time.sleep(2)

# Wyścig
zwyciezca = None

while zwyciezca is None:
    for i in range(len(zolwie)):
        ruch = random.randint(1, 20)
        zolwie[i].forward(ruch)

        if zolwie[i].xcor() >= 250:
            zwyciezca = kolory[i]
            break

# Sprawdzenie typowania
wyniki.clear()

if wybor == zwyciezca:
    poprawne += 1
    trafnosc = "TRAFIONE!"
else:
    niepoprawne += 1
    trafnosc = "NIETRAFIONE!"

wyniki.write(
    "Twój typ: " + wybor
    + "\nZwycięzca: " + zwyciezca
    + "\n" + trafnosc
    + "\nPoprawne typowania: " + str(poprawne)
    + "\nNiepoprawne typowania: " + str(niepoprawne),
    font=("Arial", 12, "bold")
)

turtle.mainloop()